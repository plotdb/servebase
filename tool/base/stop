#!/usr/bin/env bash
# stop the server started by `start`, gently. see `npm stop`, infrastructure.md -> Stopping.
#
#   npm stop                  requests in flight are answered first
#   npm stop -- --wait 60     seconds to wait before killing ( 20 )
#
# only the server gets SIGTERM, not the log pipeline ( it ends with the server's output ).
# returns once everything is gone, so a `start` right after finds the port free.

cd "$(dirname "$0")/../.." || exit 1
WAIT=20
while [ $# -gt 0 ]; do
  case "$1" in
    --wait) shift; WAIT="$1" ;;
    *) echo "unknown option: $1"; exit 1 ;;
  esac
  shift
done

if [ ! -f .server.pid ]; then echo "no .server.pid found; server not running?"; exit 0; fi
PID=$(cat .server.pid)
if [ -z "$PID" ] || ! kill -0 "$PID" 2>/dev/null; then
  echo "no server running ( .server.pid is stale )."
  rm -f .server.pid
  exit 0
fi

# the server: the descendant titled `servebase:...` - a grandchild when `lsc` runs it in a node
# of its own. not found ( e.g. between restarts ): signal all children, as before.
descendants() { local c; for c in $(pgrep -P "$1"); do echo "$c"; descendants "$c"; done; }
SERVER=""
for p in $(descendants "$PID"); do
  case "$(ps -o command= -p "$p" 2>/dev/null)" in servebase:*) SERVER="$SERVER $p" ;; esac
done
kill "$PID" 2>/dev/null
if [ -n "$SERVER" ]; then kill -TERM $SERVER 2>/dev/null; else pkill -TERM -P "$PID" 2>/dev/null; fi

alive() {
  kill -0 "$PID" 2>/dev/null && return 0
  for p in $SERVER; do kill -0 "$p" 2>/dev/null && return 0; done
  return 1
}
echo -n "stopping"
start=$SECONDS
while alive; do
  if [ $(( SECONDS - start )) -ge "$WAIT" ]; then
    echo
    echo "still running after ${WAIT}s; killing it."
    [ -n "$SERVER" ] && kill -KILL $SERVER 2>/dev/null
    pkill -KILL -P "$PID" 2>/dev/null
    kill -KILL "$PID" 2>/dev/null
    rm -f .server.pid
    exit 1
  fi
  echo -n "."
  sleep 1
done
echo
echo "server stopped."
