upstream !{name}_api {
  server !{ip}:!{port};
}

server {
  listen 443 ssl;
  #listen 443 ssl http2;
  # for IPv6
  #listen [::]:443 ssl http2 ipv6only=on;
  include !{nginxCfgDir}/mime.types;
  server_name !{hostname};
  server_tokens off;
  ssl_certificate !{cert.crt};
  ssl_certificate_key !{cert.key};
  root !{root};

  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Content-Security-Policy "frame-ancestors 'self'" always;

  location = /err/490 {
    error_page 490 /err/490.html;
    return 490;
  }

  # default avatar - redirect any /assets/avatar/* to the fallback avatar image.
  # navtop handler avatar selector by using /assets/avatar/<userid> yet demo site don't support this.
  # put before the static-file location so *.png under this path still redirects.
  location ~ ^/assets/avatar/ {
    return 302 /assets/img/avatar/1.png;
  }

  location ~ ^/ws$ {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
    proxy_pass http://!{name}_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 30m;
    proxy_send_timeout 30m;
    proxy_read_timeout 30m;
  }

  # asset cache policy. see doc/base/infrastructure.md -> Asset Cache Policy, and
  # verify a running origin with `npm run cachecheck -- <origin>`.
  #
  # two traps, both silent:
  #  - `add_header` does not inherit: a location that sets one loses the whole
  #    server-level set above, so each block repeats the security headers.
  #  - regex locations match in source order, first match wins. the generic extension
  #    rule has to come LAST or it swallows everything below it.

  # content-addressed: the name only ever means one byte sequence.
  # `try_files` falls back to the plain name when the addressed file has been expired,
  # so html older than the retention window serves the current build instead of 404ing.
  # that build may not be what the page expects, which is what a "site updated, please
  # reload" prompt is for - but a slightly-newer script beats a broken page.
  location ~ "^/(?<hashed_base>(?:js|css|assets/bundle|modules)/.*)\.[0-9a-f]{12}(?<hashed_ext>(?:\.min)?\.(?:js|css|html))$" {
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri /$hashed_base$hashed_ext =404;
  }

  # fedep symlinks - `main` and `local` point at whatever is installed now.
  location ~ ^/assets/lib/[^/]+/(?:main|local)/ {
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header Cache-Control "no-cache" always;
  }

  # an exact version directory never changes contents.
  location ~ ^/assets/lib/[^/]+/[^/]+/ {
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # plain build output: same url, different bytes after the next build. correctness
  # rests on revalidation here, so this must not be cached.
  location ~ ^/(?:js|css|assets/bundle|modules)/ {
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header Cache-Control "no-cache" always;
  }

  # everything else ( images, fonts ). keep this LAST of the asset rules.
  location ~ \.(?:ico|gif|jpe?g|png|svg|woff2?|ttf|otf)$ {
    expires 1d;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header 'Pragma' 'public';
    add_header 'Cache-Control' 'public';
  }

  location ~ ^/modules/error/(.*)$ {
    root !{root};
    try_files /modules/error/$1 /modules/error/$1/index.html /assets/lib/@servebase/erratum/main/block/$1 /assets/lib/@servebase/erratum/main/block/$1/index.html @apiserver;
  }

  location ~ ^/(.*)$ {
    root !{root};
    try_files /$1 /$1/index.html @apiserver;
  }

  location @apiserver {

    # i18n path - save locale in lng and store it in I18n-Locale header.
    #             express server can config i18next-http-middleware to get lng from that header.
    rewrite ^/intl/(?<lng>.*)/(.*) /$2 break;
    proxy_set_header I18n-Locale $lng;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://!{name}_api;

    # we use location block instead of error_page directive to handle error 490
    # because cookie wont pass through proxy_intercept_errors to error_page dir.
    proxy_intercept_errors on;

    proxy_redirect off;
    #limit_req zone=api burst=7 nodelay;
  }
}

server {
  listen 80;
  server_name !{hostname};
  add_header Strict-Transport-Security "max-age=16070400; includeSubDomains";
  location / {
    if ($http_user_agent !~* (facebook) ) {
      return 301 https://$host$request_uri;
    }
    root !{root};
  }
  #rewrite     ^   https://$server_name$request_uri? permanent;
}
