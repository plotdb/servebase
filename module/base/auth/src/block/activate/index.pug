.m-auto(style="max-width:27em;padding:0 .66em")
  script(type="@plotdb/block"): include:lsc index.ls
  .text-center
    h1(t) title
    p.text-muted.mb-4(t) desc
    br
    form#activate.form.text-left.m-auto(method="POST")
      .from-group.mb-3
        label(t) enter.new
        input.form-control(name="password",type="password",t,t-placeholder="enter.min",autocomplete="new-password")
        .invalid-feedback(t) enter.weak
      .from-group.mb-3
        label(t) enter.again
        input.form-control(name="confirm",type="password",placeholder="",autocomplete="new-password")
        .invalid-feedback(t) enter.mismatch
      input.btn.btn-success.btn-block.mt-2.disabled(ld="submit",type="button",t,t-value="setup")
      br
      br
      .text-muted: small
        p(t) hint.0
        p
          span(t) hint.1.0
          a.mx-1(href="https://en.wikipedia.org/wiki/Password_strength",
          target="_blank",rel="noopener noreferrer",t) hint.1.1
          span(t) hint.1.2

  .ldcv.ldcvmgr.autogap.scroll(data-name="activate-done",data-lock="true"): .base.w-640.rwd: .inner
    .text-center: h1(t) done.title
    .my-4: p(t) done.desc
    .row
      .col-sm.mb-2: .btn.btn-lg.btn-block.btn-primary(data-ldcv-set="login",t) login now
      .col-sm.mb-2: a.btn.btn-lg.btn-block.btn-outline-secondary(href="/",t) homepage

  .ldcv.ldcvmgr.autogap.scroll(data-name="activate-invalid",data-lock="true"): .base.w-480.rwd: .inner
    .text-center
      h1(t) invalid.title
      p(t) invalid.desc
    .text-muted.my-4
      p
        span(t) invalid.note.0
        a.mx-1(href="/auth/?passwd-reset",t) invalid.note.1
        span(t) invalid.note.2
      p(t) invalid.note.3
    .row
      .col-sm.mb-2: a.btn.btn-lg.btn-block.btn-primary(href="/auth/?passwd-reset",t) send again
      .col-sm.mb-2: a.btn.btn-lg.btn-block.btn-outline-secondary(href="/auth/",t) login
